SelectQRImageScreen {
    layout: vertical;
    align: center middle;
}

TOTPSite {   
    background: $boost;
    margin: 1;
    height: 5;
    /*min-width: 10;*/
    padding: 1;
}

TOTPCodeDisplay {   
    /*text-align: center;*/
    color: $foreground-muted;
    width: 7fr;
}

#qr-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    padding: 0 1;
    width: 60%;
    height: 50%;
    border: thick $background 80%;
    background: $surface;
    align: center middle;
}

#qr-file-tree {
    column-span: 2;
    row-span: 3;
    height: 10;
}

#qr-path-input {
    height: 3;
    column-span: 2;
}

.qr-dialog-button {
    height: 3;
    /*border: solid red;*/
    width: 20%;
}

#qr-ok-button {
}
#qr-cancel-button {
}


#vscroll {
    height: 100%;
    border: solid purple;
}

#totp-name {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}

#totp-issuer {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}

#totp-time-remaining {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}
