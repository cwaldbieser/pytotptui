
TOTPSite {   
    background: $boost;
    margin: 1;
    height: 5;
    /*min-width: 10;*/
    padding: 1;
}

TOTPCodeDisplay {   
    /*text-align: center;*/
    color: $foreground-muted;
    width: 7fr;
}

#vscroll {
    height: 100%;
    border: solid purple;
}

#totp-name {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}

#totp-issuer {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}

#totp-time-remaining {
    height: 100%;
    width: 1fr;
    content-align-vertical: middle;
}
